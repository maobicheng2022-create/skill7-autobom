* text=auto

# 源码/文档统一 LF（Windows 上 Python 也照跑）
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf

# PowerShell / 批处理用 CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制，禁止换行/文本转换
*.swp  binary
*.exe  binary
*.dll  binary
*.pdb  binary
*.xlsx binary
*.xls  binary
*.bmp  binary
*.png  binary
*.ico  binary
*.db   binary